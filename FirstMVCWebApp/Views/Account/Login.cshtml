@{
    ViewData["Title"] = "Login";
}

<style>
    /* =====================================
           LIBRARY LOGIN PAGE
           ===================================== */

    .library-login-bg {
        min-height: 100vh;
        background: #f3f6f8;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 15px;
        box-sizing: border-box;
    }


    /* =====================================
           LOGIN CARD
           ===================================== */

    .library-login-card {
        width: 390px;
        min-height: 500px;
        background: #ffffff;
        border-radius: 6px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
        overflow: hidden;
        box-sizing: border-box;
    }


    /* =====================================
           HEADER
           ===================================== */

    .library-login-header {
        background: #000000;
        color: #ffffff;
        text-align: center;
        padding: 27px 18px;
        box-sizing: border-box;
    }

        .library-login-header h2 {
            margin: 0;
            font-size: 23px;
            font-weight: 600;
            color: #ffffff;
        }


    /* =====================================
           BODY
           ===================================== */

    .library-login-body {
        padding: 40px 28px 30px 28px;
        box-sizing: border-box;
    }


        /* FORM GROUP */

        .library-login-body .form-group {
            margin-bottom: 26px;
        }


        /* LABEL */

        .library-login-body .form-label {
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #34495e;
        }


        /* INPUT */

        .library-login-body .form-control {
            width: 100%;
            height: 43px;
            padding: 0 12px;
            border: 1px solid #cbd5dc;
            border-radius: 4px;
            background: #ffffff;
            color: #333333;
            font-size: 13px;
            box-sizing: border-box;
            outline: none;
        }

            .library-login-body .form-control:focus {
                border-color: #000000;
                box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.12);
            }


    /* =====================================
           LOGIN BUTTON
           ===================================== */

    .library-login-btn {
        width: 100%;
        height: 43px;
        margin-top: 3px;
        border: none;
        border-radius: 4px;
        background: #000000;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .library-login-btn:hover {
            background: #1f1f1f;
        }


    /* =====================================
           FORGOT PASSWORD / CONTACT ADMIN
           ===================================== */

    .modern-login-link {
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: 0.2s ease;
    }

    .link-primary-custom {
        color: #000000 !important;
    }

        .link-primary-custom:hover {
            color: #333333 !important;
            text-decoration: underline !important;
        }

    .link-secondary-custom {
        color: #000000 !important;
    }

        .link-secondary-custom:hover {
            color: #333333 !important;
            text-decoration: underline !important;
        }


    /* =====================================
           ERROR MESSAGE
           ===================================== */

    .library-error {
        margin-bottom: 20px;
        padding: 8px 10px;
        border: 1px solid #e0b4b4;
        border-radius: 4px;
        background: #fff5f5;
        color: #c0392b;
        text-align: center;
        font-size: 12px;
    }


    /* =====================================
           FOOTER
           ===================================== */

    .library-footer {
        margin-top: 34px;
        text-align: center;
        color: #7b8790;
        font-size: 10px;
    }


    /* =====================================
           MOBILE
           ===================================== */

    @@media (max-width: 500px) {

        .library-login-card {
            width: 100%;
            max-width: 390px;
        }

        .library-login-body {
            padding: 35px 24px 28px 24px;
        }
    }
</style>

<div class="library-login-bg">

    <div class="library-login-card">

        <!-- HEADER -->
        <div class="library-login-header">
            <h2>Library Management System App</h2>
        </div>


        <!-- LOGIN BODY -->
        <div class="library-login-body">

            @if (ViewBag.Error != null)
            {
                <div class="library-error">
                    @ViewBag.Error
                </div>
            }

            <form method="post" action="/Account/Login">

                <!-- USERNAME -->
                <div class="form-group">

                    <label class="form-label">
                        Username
                    </label>

                    <input type="text"
                           name="username"
                           class="form-control"
                           autocomplete="off"
                           required />

                </div>


                <!-- PASSWORD -->
                <div class="form-group">

                    <label class="form-label">
                        Password
                    </label>

                    <input type="password"
                           name="password"
                           class="form-control"
                           autocomplete="off"
                           required />

                </div>


                <!-- LOGIN BUTTON -->
                <button type="submit" class="library-login-btn">
                    Login
                </button>


                <!-- FORGOT PASSWORD / CONTACT ADMIN -->
                <div class="d-flex justify-content-between align-items-center mt-4 px-1">

                    <a href="@Url.Action("ForgotPassword", "Account")"
                       class="modern-login-link link-primary-custom">
                        Forgot Password?
                    </a>

                    <a href="@Url.Action("Contact", "Account")"
                       class="modern-login-link link-secondary-custom">
                        Contact Admin
                    </a>

                </div>


                <!-- FOOTER -->
                <div class="library-footer">
                    © 2026 Library Management System App. All rights reserved.
                </div>

            </form>

        </div>

    </div>

</div>