@{
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card bg-dark text-white shadow">
                <div class="card-header border-bottom border-secondary text-center">
                    <h3>Account Portal</h3>
                </div>
                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger text-center py-2" role="alert">
                            @ViewBag.Error
                        </div>
                    }

                    <form method="post" action="/Account/Login">
                        <div class="form-group mb-3">
                            <label class="form-label">Username</label>
                            <input type="text" name="username" class="form-control" autocomplete="off" required />
                        </div>
                        <div class="form-group mb-4">
                            <label class="form-label">Password</label>
                            <input type="password" name="password" class="form-control" autocomplete="off" required />
                        </div>

                       
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary w-100">Log In</button>
                        </div>


                      
                    
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-secondary">

                          
                            <a href="/Account/ForgotPassword" class="text-decoration-none text-muted small hover-blue" style="font-size: 0.85rem; transition: color 0.2s;">
                                <i class="fas fa-key me-1"></i>Forgot Password?
                            </a>

                       
                            <a href="/Account/Contact" class="text-decoration-none text-muted small hover-blue" style="font-size: 0.85rem; transition: color 0.2s;">
                                <i class="fas fa-headset me-1"></i>Need Help?
                            </a>


                        </div>

                        <style>
                            .hover-blue {
                                color: #6c757d !important; 
                            }

                                .hover-blue:hover {
                                    color: #0d6efd !important; 
                                    text-decoration: underline !important; 
                                }
                        </style>


                    </form>


                </div>
            </div>
        </div>
    </div>
</div>
