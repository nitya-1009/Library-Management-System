@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Password Recovery - Library Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>

<body class="bg-light">

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-5">

                <div class="card bg-dark text-white shadow rounded-3 border border-secondary">

                    <div class="card-header border-bottom border-secondary text-center py-3">
                        <h3 class="m-0 fw-bold">
                            <i class="fas fa-key me-2 text-warning"></i>
                            Password Recovery
                        </h3>
                    </div>

                    <div class="card-body p-4 text-center">

                        <p class="text-muted">
                            For security purposes, your administrator login
                            credentials are shown below.
                        </p>

                        <div class="alert alert-secondary text-center my-4 py-3 border-0 bg-secondary text-white shadow-sm">

                            <small class="text-white-50 d-block mb-1">
                                YOUR ADMIN PASSWORD
                            </small>

                            <strong style="font-size: 1.4rem; letter-spacing: 1px; color: #ffca28;">
                                Admin@123
                            </strong>

                        </div>

                        <p class="small text-danger mb-4">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Please keep your login credentials secure and do not
                            share them with unauthorized users.
                        </p>

                        <div class="d-grid">
                            <a href="/Account/Login"
                               class="btn btn-primary fw-bold py-2">
                                <i class="fas fa-arrow-left me-2"></i>
                                Back to Login
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>