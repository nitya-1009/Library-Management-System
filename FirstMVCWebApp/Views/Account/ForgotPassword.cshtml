@{
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card bg-dark text-white shadow rounded-3">
                <div class="card-header border-bottom border-secondary text-center py-3">
                    <h3 class="m-0 fw-bold"><i class="fas fa-key me-2 text-warning"></i>Password Recovery</h3>
                </div>
                <div class="card-body p-4 text-center">

                    <!-- English Conversion Text -->
                    <p class="text-muted">Since you are the sole Administrator of this portal, your static login credentials have been displayed below for security purposes:</p>

                    <!-- Admin Password Info Block -->
                    <div class="alert alert-secondary text-center my-4 py-3 border-0 bg-secondary text-white shadow-sm">
                        <small class="text-white-50 d-block mb-1">YOUR ADMIN PASSWORD</small>
                        <strong style="font-size: 1.4rem; letter-spacing: 1px; color: #ffca28;">Admin@123</strong>
                    </div>

                    <!-- Warning Subtext -->
                    <p class="small text-danger mb-4"><i class="fas fa-exclamation-triangle me-1"></i>Please note down this password in a secure place and do not share it with unauthorized users.</p>

                    <!-- Navigation Action Button -->
                    <div class="d-grid">
                        <a href="/Account/Login" class="btn btn-primary fw-bold py-2">
                            <i class="fas fa-arrow-left me-2"></i>Back to Login
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
