@model FirstMVCWebApp.Models.StudentRegistrationViewModel
<style>
    .card {
        border-radius: 20px;
        overflow: hidden; /* card ke corner class rahege */
    }

    .card-header {
        margin-bottom: 0;
        padding: 15px;
        font-size: 24px;
        font-weight: 500;
    }

    .table thead th {
        background: #efe2ff !important;
        text-align: center;
        vertical-align: middle;
        white-space: nowrap;
    }

    .table td {
        vertical-align: middle;
    }

    .btn {
        border-radius: 4px;
    }

    .table-wrapper {
        max-height: 500px; /* Adjust this value to change visible height */
        overflow-y: auto;
    }

    /* Freezes the table header at the top of the scroll wrapper */
    .table-primary th {
        position: sticky !important;
        top: 0;
        z-index: 2;
        background-color: #efe2ff !important; /* Keeps your header color solid while scrolling */
    }

    
    /* इनपुट पर क्लिक करने पर Bootstrap की अपनी नीली शैडो बंद करने के लिए */
    .input-group .form-control:focus {
        box-shadow: none !important;
    }
    /* जब पूरे बॉक्स पर होवर हो या उसके अंदर क्लिक (focus) हो */
    .input-group:hover,
    .input-group:focus-within {
        outline: 2px solid #0d6efd !important; /* Bootstrap का Primary Blue कलर */
        border-radius: 0.375rem; /* कोनों को गोल रखने के लिए */
    }

    /* 💡 फॉर्म के सामान्य इनपुट बॉक्स के placeholder का रंग गहरा/साफ़ करने के लिए */
    .form-control::placeholder {
        color: #6c757d !important; /* यह टेक्स्ट को हल्का ग्रे (गहरा) रखेगा ताकि सफ़ेद बैकग्राउंड पर साफ़ दिखे */
        opacity: 1 !important;
    }

    /* 🔍 सर्च बार (जो गहरे रंग का है) के placeholder का रंग हल्का सफ़ेद रखने के लिए */
    .custom-search-box .form-control::placeholder {
        color: rgba(255, 255, 255, 0.7) !important;
    }
</style>

@{
    ViewData["Title"] = "Student Registration";
}

<style>
    /* टेबल के हेडर को फिक्स रखने की स्टाइल */
    .table-primary th {
        position: sticky !important;
        top: 0;
        z-index: 2;
        background-color: #efe2ff !important;
    }
</style>

<div class="container-fluid px-4">


    <div class="row mt-4 align-items-stretch">



        <div class="col-12 mb-4">

            <div class="card bg-white shadow rounded-3 p-0 h-100">

                <!-- Student Registration Black Header Panel -->
                <div class="card-header bg-dark text-white text-center py-3 mb-4 rounded-top">
                    <h3 class="m-0 fw-bold">Student Registration</h3>
                </div>

                <div class="px-4 pb-4">




            <form id="studentForm" asp-action="Save" method="post">

                
                <input type="hidden" name="Student.Id" value="@Model.Student?.Id" />
                <!-- Add this hidden field next to your other hidden inputs inside the form -->
                <input type="hidden" asp-for="Student.ActiveStatus" />


                <div class="row">


                  
                    <!-- Name -->
                    <div class="col-md-6 mb-4">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                                <input asp-for="Student.Name" class="form-control" placeholder="Enter name" />
                        <span asp-validation-for="Student.Name" class="text-danger"></span>
                    </div>

                    <!-- Roll No -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Roll No <span class="text-danger">*</span></label>
                                <input asp-for="Student.RollNo" class="form-control" placeholder="Enter roll number" />
                        <span asp-validation-for="Student.RollNo" class="text-danger"></span>
                    </div>

                    <!-- Gender -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label d-block">Gender <span class="text-danger">*</span></label>

                        <div class="form-check form-check-inline">
                            <!-- Change name="Gender" to asp-for="Student.Gender" -->
                            <input class="form-check-input" type="radio" asp-for="Student.Gender" value="Male">
                            <label class="form-check-label">Male</label>
                        </div>

                        <div class="form-check form-check-inline">
                            <!-- Change name="Gender" to asp-for="Student.Gender" -->
                            <input class="form-check-input" type="radio" asp-for="Student.Gender" value="Female">
                            <label class="form-check-label">Female</label>
                        </div>

                        <!-- This validation tag helper will now work correctly -->
                        <span asp-validation-for="Student.Gender" class="text-danger"></span>
                    </div>

                            <!-- Course -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Course <span class="text-danger">*</span></label>
                                <select name="Student.Course" class="form-select" required>
                                    <option value="">Select Course</option>

                                    @if (Model.Student?.Course == "BTECH")
                                    {
                                        <option value="BTECH" selected>BTECH</option>
                                    }
                                    else
                                    {
                                        <option value="BTECH">BTECH</option>
                                    }

                                    @if (Model.Student?.Course == "BA")
                                    {
                                        <option value="BA" selected>BA</option>
                                    }
                                    else
                                    {
                                        <option value="BA">BA</option>
                                    }

                                    @if (Model.Student?.Course == "BCOM")
                                    {
                                        <option value="BSC" selected>BCOM</option>
                                    }
                                    else
                                    {
                                        <option value="BCOM">BCOM</option>
                                    }
                                </select>
                            </div>



                    <!-- Branch -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label ">Branch</label>
                                <input asp-for="Student.Branch" class="form-control" placeholder="Enter branch" />
                        <span asp-validation-for="Student.Branch" class="text-danger"></span>
                    </div>
                    <!-- Semester -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Semester <span class="text-danger">*</span></label>
                                <input asp-for="Student.Semester" class="form-control" placeholder="Enter semester" />
                        <span asp-validation-for="Student.Semester" class="text-danger"></span>
                    </div>

                    <!-- Father Name -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Father Name <span class="text-danger">*</span></label>
                                <input asp-for="Student.FatherName" class="form-control" placeholder="Enter father name" />
                        <span asp-validation-for="Student.FatherName" class="text-danger"></span>
                    </div>

                    <!-- Mother Name -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Mother Name <span class="text-danger">*</span></label>
                                <input asp-for="Student.MotherName" class="form-control" placeholder="Enter mother name" />
                        <span asp-validation-for="Student.MotherName" class="text-danger"></span>
                    </div>
                    <!-- Email -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email <span class="text-danger">*</span></label>
                                <input asp-for="Student.Email" class="form-control" placeholder="Enter email" />
                        <span asp-validation-for="Student.Email" class="text-danger"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone <span class="text-danger">*</span></label>
                                <input asp-for="Student.Phone" class="form-control" placeholder="Enter phone number" />
                        <span asp-validation-for="Student.Phone" class="text-danger"></span>
                    </div>

                    <!-- City -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">City <span class="text-danger">*</span></label>
                                <input asp-for="Student.City" class="form-control" placeholder="Enter city" />
                        <span asp-validation-for="Student.City" class="text-danger"></span>
                    </div>

                    <!-- Marks -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Marks <span class="text-danger">*</span></label>
                                <input asp-for="Student.Marks" class="form-control" placeholder="Enter marks" />
                        <span asp-validation-for="Student.Marks" class="text-danger"></span>
                    </div>

                    <!-- Address -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Address <span class="text-danger">*</span></label>
                                <input asp-for="Student.Address" class="form-control" placeholder="Enter address" />
                        <span asp-validation-for="Student.Address" class="text-danger"></span>
                    </div>

                    <div class="mt-4 text-end">

                        
                        <button type="submit" class="btn btn-success px-4 mx-1">Submit</button>

                       
                        <button type="submit" class="btn btn-primary px-4 mx-1">Update</button>


                            
                    </div>



                       
                        </div>

                </form>
                </div>
            </div>
        </div> 
    </div>
</div>
<!-- PERFECTLY UNIFIED GREY SEARCH BAR -->
<div class="card bg-white p-3 mb-4 shadow border-0">
    <form method="get" action="/Home/StudentRegistration" class="w-100">
        <div class="row g-2 align-items-center" >

            <!-- Left Side: Search Input Box with Matching Grey Icon -->
            <div class="col-md-8">
                <div class="input-group">
                    <!-- Icon box changed to matching grey to remove any white gap -->
                    <span class="input-group-text border-end-0 text-white" style="background-color: #6B7280 !important;">
                        <i class="fas fa-search"></i>
                    </span>
                    <!-- Input box with placeholder text color styling -->
                    <input type="text" name="globalSearch" id="studentSearchInput" class="form-control border-start-0 custom-grey-search" placeholder="Type anything to search..." autocomplete="off" value="@Context.Request.Query["globalSearch"]" style="background-color: #6B7280 !important; color: white !important;" />
                </div>
            </div>

            <!-- Middle: Search Button -->
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Search</button>
            </div>

            <!-- Right Side: Reset Button -->
            <div class="col-md-2">
                <a href="/Home/StudentRegistration" class="btn btn-outline-dark w-100 fw-bold">Reset</a>
            </div>

        </div>
    </form>
</div>

<!-- STYLING TO FORCE THE PLACEHOLDER TEXT TO BE VISIBLE -->
<style>
    .custom-grey-search::placeholder {
        color: rgba(255, 255, 255, 0.75) !important; /* Forces placeholder text to be bright and visible */
        opacity: 1 !important;
    }
</style>



    
   
    <div style="clear: both; width: 100%; display: block; flex-basis: 100%;"></div>



    <!-- Student List Table Card -->
    <div class="card shadow-lg mt-4 border-0">


        <div class="card-header bg-dark text-white text-center py-3">
            <h3 class="mb-0 fw-bold"> Student List</h3>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped mb-0">

                    <thead class="table-primary">
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Gender</th>
                            <th>Course</th>
                            <th>Roll No</th>
                            <th>Branch</th>
                            <th>Semester</th>
                            <th>Father Name</th>
                            <th>Mother Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Address</th>
                            <th>City</th>
                            <th>Marks</th>
                            <th>Created By</th>
                            <th>Created On</th>
                            <th>Active Status</th>
                            <th>View Books</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="studentsTableBody">
                        @if (Model != null && Model.Students != null && Model.Students.Any())
                        {
                            @foreach (var item in Model.Students)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Name</td>
                                    <td>@item.Gender</td>
                                    <td>@item.Course</td>
                                    <td>@item.RollNo</td>
                                    <td>@item.Branch</td>
                                    <td>@item.Semester</td>
                                    <td>@item.FatherName</td>
                                    <td>@item.MotherName</td>
                                    <td>@item.Email</td>
                                    <td>@item.Phone</td>
                                    <td>@item.Address</td>
                                    <td>@item.City</td>
                                    <td>@item.Marks</td>
                                    <td>@item.CreatedBy</td>
                                    <td>@item.CreatedOn</td>
                                    <td>@(item.ActiveStatus == true ? "Active" : "Inactive")</td>

                               
                                <td>
                                    <a href="/Home/StudentBooks/@item.Id" class="btn btn-info btn-sm text-white fw-bold">
                                        <i class="fas fa-book-open"></i> View
                                    </a>
                                </td>

                                    <td style="vertical-align: middle;">
                                        <div class="d-flex gap-2 justify-content-center" style="min-width: 130px;">
                                            <!-- वर्किंग एडिट बटन लिंक -->
                                            <a href="@Url.Action("Edit", "Home", new { id = item.Id })" class="btn btn-primary btn-sm w-50 fw-bold py-1">Edit</a>

                                            <!-- वर्किंग डिलीट बटन लिंक -->
                                            <a href="@Url.Action("Delete", "Home", new { id = item.Id })" class="btn btn-danger btn-sm w-50 fw-bold py-1" onclick="return confirm('क्या आप इस छात्र को हटाना चाहते हैं?');">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="18" class="text-center text-muted py-3">
                                    No records found
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div> 
        </div> 
    </div> 
@section Scripts
{
    <script type="text/javascript">
                // Ensure we only declare the function once globally
                               function validateStudentForm(event) {
            let isValid = true;

            // 1. Clear out all old error messages
            const errorIds = [
                "nameError", "genderError", "courseError", "rollNoError",
                "fatherNameError", "motherNameError", "semesterError",
                "emailError", "phoneError", "addressError", "cityError", "marksError"
            ];
            errorIds.forEach(id => {
                const element = document.getElementById(id);
                if (element) element.innerHTML = "";
            });

            // 💡 IMPROVED HELPER: Searches by ID first, then falls back to Name if not found
            function getFieldValueFallback(id, alternateName) {
                let el = document.getElementById(id);
                if (!el) {
                    let nameElements = document.getElementsByName(alternateName);
                    if (nameElements && nameElements.length > 0) {
                        el = nameElements[0];
                    }
                }
                return el ? el.value.trim() : "";
            }

            // 2. Perform Clean Validations
            if (getFieldValueFallback("Student_Name", "Student.Name") === "") {
                document.getElementById("nameError").innerHTML = "Name is required";
                isValid = false;
            }
            if (getFieldValueFallback("Student_Gender", "Student.Gender") === "") {
                document.getElementById("genderError").innerHTML = "Gender is required";
                isValid = false;
            }
            if (getFieldValueFallback("Student_Course", "Student.Course") === "") {
                document.getElementById("courseError").innerHTML = "Course is required";
                isValid = false;
            }
            if (getFieldValueFallback("Student_RollNo", "Student.RollNo") === "") {
                document.getElementById("rollNoError").innerHTML = "RollNo is required";
                isValid = false;
            }
            if (getFieldValueFallback("Student_FatherName", "Student.FatherName") === "") {
                document.getElementById("fatherNameError").innerHTML = "FatherName is required";
                isValid = false;
            }
            if (getFieldValueFallback("Student_MotherName", "Student.MotherName") === "") {
                document.getElementById("motherNameError").innerHTML = "MotherName is required";
                isValid = false;
            }
            if (getFieldValueFallback("Student_Semester", "Student.Semester") === "") {
                document.getElementById("semesterError").innerHTML = "Semester is required";
                isValid = false;
            }
            if (getFieldValueFallback("Student_Email", "Student.Email") === "") {
                document.getElementById("emailError").innerHTML = "Email is required";
                isValid = false;
            }
            if (getFieldValueFallback("Student_Phone", "Student.Phone") === "") {
                document.getElementById("phoneError").innerHTML = "Phone is required";
                isValid = false;
            }
            if (getFieldValueFallback("Student_Address", "Student.Address") === "") {
                document.getElementById("addressError").innerHTML = "Address is required";
                isValid = false;
            }
            if (getFieldValueFallback("Student_City", "Student.City") === "") {
                document.getElementById("cityError").innerHTML = "City is required";
                isValid = false;
            }
            if (getFieldValueFallback("Student_Marks", "Student.Marks") === "") {
                document.getElementById("marksError").innerHTML = "Marks is required";
                isValid = false;
            }

            // 3. Handle Form Submission or Blockage Safely
            if (!isValid) {
                if (event) event.preventDefault();
                return false;
            }

            return true;
        }

        // Attach the validation listener securely
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("studentForm");
            if (form) {
                form.addEventListener("submit", function (e) {
                    validateStudentForm(e);
                });
            }
        });

        </script>
     }

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Student search input field ko select kar rahe hain
        var searchBox = document.getElementById("studentSearchInput");

        if (searchBox) {

            // Har ek keystore/input par event listener trigger hoga
            searchBox.addEventListener("input", function () {

                var searchKeyword = this.value;

                // Backend controller ko keyword ke sath hit kar rahe hain
                fetch('/Home/SearchStudents?query=' + encodeURIComponent(searchKeyword))
                    .then(response => response.text())
                    .then(htmlResult => {

                        // Table body ko select kar rahe hain jahan naya data dikhana hai
                        var tableBody = document.getElementById("studentsTableBody");

                        if (tableBody) {
                            // Purane data ko naye HTML result se replace kar rahe hain
                            tableBody.innerHTML = htmlResult;
                        }

                    })
                    .catch(err =>
                        console.error("Live search failed:", err)
                    );

            });

        }

    });
</script>
